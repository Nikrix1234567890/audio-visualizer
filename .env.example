# Copy this file to .env and fill in real values for local development.
# .env itself is gitignored and must never be committed.

# SQLite for local dev. In production, swap for a real Postgres connection
# string (e.g. from Neon or Supabase) - the Prisma schema stays the same
# except for the `provider` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Auth.js secret, used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-generated-secret"

# Root directory (relative to project root) where uploaded audio files and
# rendered videos are stored locally during development. In production this
# will be replaced by Cloudflare R2 (see src/lib/storage.ts).
STORAGE_ROOT="storage"

# Payments (optional). Leave these out and the pricing page says that
# Premium is not on sale yet. See src/lib/stripe.ts.
#   STRIPE_SECRET_KEY      secret API key from the Stripe dashboard
#                          (use the sk_test_... key until you go live)
#   STRIPE_PRICE_ID        the recurring price of the Premium plan (price_...)
#   STRIPE_WEBHOOK_SECRET  signing secret (whsec_...) of a webhook endpoint
#                          pointing at <your site>/api/billing/webhook, with
#                          the events checkout.session.completed,
#                          customer.subscription.updated and
#                          customer.subscription.deleted
#   PREMIUM_PRICE_LABEL    what the pricing page shows, e.g. "9 EUR / month"
# STRIPE_SECRET_KEY=""
# STRIPE_PRICE_ID=""
# STRIPE_WEBHOOK_SECRET=""
# PREMIUM_PRICE_LABEL=""
