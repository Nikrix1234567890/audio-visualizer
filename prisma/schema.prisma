// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Tier {
  FREE
  PREMIUM
}

enum RenderStatus {
  QUEUED
  RENDERING
  DONE
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  // Set when the user followed the link in the confirmation mail.
  emailVerified DateTime?
  tier         Tier     @default(FREE)
  // Set once the user has paid through Stripe; lets the payment webhook
  // find the account again when a subscription ends.
  stripeCustomerId String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects   Project[]
  uploads    Upload[]
  savedScenes SavedScene[]
  renderJobs RenderJob[]
}

// A scene the user kept as their own template. Anyone who has its id (an
// unguessable address) may load it - that is how a scene is shared by link.
// It holds no track: only elements, camera and look.
model SavedScene {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  scene     Json
  createdAt DateTime @default(now())

  @@index([userId])
}

// One row per uploaded file (track, picture, 3D model). It records who the
// file belongs to: a file with an owner is only handed to that account, a
// file without one (uploaded while not logged in) to anyone who knows its
// random address. Files from before this table existed have no row and
// count as ownerless.
model Upload {
  // Storage key, as handed out by /api/upload: "uploads/<uuid>.<ext>".
  key       String   @id
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  size      Int
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  // Path to the uploaded audio file, relative to the local storage root
  // (see src/lib/storage.ts). Swappable for an R2 object key later.
  audioPath String
  // Visualizer configuration (colors, layout, bar count, camera, etc.)
  // stored as JSON so the schema doesn't need to change every time we add
  // a new visualizer setting.
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  renderJobs RenderJob[]
}

model RenderJob {
  id        String   @id @default(cuid())
  // Nullable: anonymous (not-logged-in) renders aren't attached to a saved
  // Project. Once a user is logged in and projects are persisted, jobs can
  // be linked for history/quota purposes.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Who started the render, if they were logged in. Their finished video
  // is then only handed to them.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Denormalized so a job is fully self-contained even without a Project.
  audioKey String
  settings Json

  status       RenderStatus @default(QUEUED)
  progress     Float        @default(0)
  // Path to the finished MP4, relative to the local storage root, once DONE.
  outputPath   String?
  errorMessage String?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?
}
